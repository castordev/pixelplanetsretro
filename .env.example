# Copia este archivo a .env y configura tus valores locales
# No commits .env con información sensible - ya está en .gitignore

# Modo debug (1 para desarrollo, 0 para producción)
DJANGO_DEBUG=1

# Clave secreta para Django (cambia esto en producción)
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=tu-clave-secreta-muy-larga-aqui

# Hosts permitidos (separados por comas)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Configuración de base de datos (opcional, por defecto usa SQLite)
# DATABASE_URL=sqlite:///db.sqlite3
# O para PostgreSQL: postgresql://user:password@localhost:5432/dbname
